{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": "test/db/.*\\.db-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": false
      }
    ]
  },
  "globalSetup": "<rootDir>/test/db/global-setup.ts",
  "maxWorkers": 1,
  "testTimeout": 60000,
  "moduleNameMapper": {
    "^expo-server-sdk$": "<rootDir>/test/db/stubs/expo-server-sdk.ts"
  }
}
